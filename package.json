{
  "name": "raivat-education-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server that lets AI clients explore the public RaivatEdu education-software marketing website (raivatedu.com).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "raivat-education-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/index.ts --http",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "raivatedu",
    "education",
    "claude",
    "llm"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
