# RaivatEdu MCP Server configuration (all variables are OPTIONAL).
# Copy this file to `.env` and adjust only if you need non-default behaviour.
# The server works out of the box with no configuration.

# Default market/locale used when a tool call does not specify one.
# Allowed values: in, us, gb, ca, au, nz, ie, sg, ae, za
RAIVATEDU_DEFAULT_MARKET=in

# Per-request HTTP timeout in milliseconds (default: 15000, min 1000, max 60000).
RAIVATEDU_TIMEOUT_MS=15000

# Minimum delay in milliseconds enforced between outbound HTTP requests to the
# website, to stay polite and avoid hammering the origin (default: 250).
RAIVATEDU_MIN_REQUEST_INTERVAL_MS=250

# Number of times to retry a failed/transient request (default: 2, max 5).
RAIVATEDU_MAX_RETRIES=2

# Optional override for the User-Agent sent with requests. Keep it descriptive
# and honest. Default identifies the server as a read-only MCP client.
# RAIVATEDU_USER_AGENT=raivat-education-mcp/1.0 (+https://github.com/MeruLocal/raivatedu_MCP)

# Log level for stderr diagnostics: debug | info | warn | error | silent (default: info).
RAIVATEDU_LOG_LEVEL=info

# --- Page cache and outbound limits -----------------------------------------
# How long a fetched page is cached, in ms (default 600000 = 10 min, max 3600000).
# 0 turns the cache off.
# RAIVATEDU_CACHE_TTL_MS=600000

# Maximum number of cached pages (default 500).
# RAIVATEDU_CACHE_MAX_ENTRIES=500

# Ceiling on simultaneous outbound requests to raivatedu.com (default 4, 1-32).
# RAIVATEDU_MAX_CONCURRENT_REQUESTS=4

# Maximum pages one raivatedu_search_content call fetches (0 = no cap).
# Unset: no cap on stdio, 12 on the public HTTP transport.
# RAIVATEDU_SEARCH_MAX_PAGES=12

# Maximum bytes read from one website response (default 2097152 = 2 MB).
# RAIVATEDU_MAX_RESPONSE_BYTES=2097152

# --- HTTP transport guards (only used with --http / TRANSPORT=http) ---------
# Host header allowlist for POST /mcp (DNS-rebinding protection), comma-separated.
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],mcp.raivatedu.com

# Browser origins allowed to call POST /mcp. Requests with no Origin header
# (CLI and server-side clients) and localhost origins are always allowed.
# MCP_ALLOWED_ORIGINS=https://mcp.raivatedu.com,https://raivatedu.com,https://www.raivatedu.com

# Requests per minute per client IP on /mcp (default 60; 0 turns it off).
# MCP_RATE_LIMIT_PER_MIN=60

# Set to 1 behind Cloudflare/Apache so the rate limit keys on the right-most
# X-Forwarded-For hop instead of the proxy's address.
# TRUST_PROXY=1

# Public base URL advertised by the discovery document, the status page and
# /version (HTTP only). Default: https://mcp.raivatedu.com. Never derived from
# the request's Host header. For local use:
# PUBLIC_BASE_URL=http://localhost:3000

# How often the page catalog is rebuilt from the live sitemap, in ms
# (default 86400000 = 24 h, minimum 60000). 0 turns the sitemap off and keeps
# the verified 2026-10-13 snapshot. Requests never wait for the sitemap.
# RAIVATEDU_SITEMAP_REFRESH_MS=86400000
