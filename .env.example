# RaivatEdu MCP Server configuration (all variables are OPTIONAL).
# Copy this file to `.env` and adjust only if you need non-default behaviour.
# The server works out of the box with no configuration.

# Default market/locale used when a tool call does not specify one.
# Allowed values: in, us, gb, ca, au, nz, ie, sg, ae, za
RAIVATEDU_DEFAULT_MARKET=in

# Per-request HTTP timeout in milliseconds (default: 15000, min 1000, max 60000).
RAIVATEDU_TIMEOUT_MS=15000

# Minimum delay in milliseconds enforced between outbound HTTP requests to the
# website, to stay polite and avoid hammering the origin (default: 250).
RAIVATEDU_MIN_REQUEST_INTERVAL_MS=250

# Number of times to retry a failed/transient request (default: 2, max 5).
RAIVATEDU_MAX_RETRIES=2

# Optional override for the User-Agent sent with requests. Keep it descriptive
# and honest. Default identifies the server as a read-only MCP client.
# RAIVATEDU_USER_AGENT=raivat-education-mcp/1.0 (+https://github.com/your-org/raivat-education-mcp)

# Log level for stderr diagnostics: debug | info | warn | error | silent (default: info).
RAIVATEDU_LOG_LEVEL=info
